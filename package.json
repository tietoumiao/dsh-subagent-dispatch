{
  "name": "dsh-subagent-dispatch",
  "version": "0.5.0",
  "description": "DeepSeek Harness plugin: dispatch subagents with per-call preset / reasoning_effort / model / provider / cwd / schema via the dispatch_subagent Host tool, run a whole workflow with per-run preset / reasoning_effort / model via the run_workflow Host tool, plus an external `dispatch` subagent provider for whole-run workflow delegation.",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "author": "tietoumiao",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "subagent",
    "dispatch",
    "provider",
    "preset",
    "reasoning-effort"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "echo no-build: plain ESM plugin",
    "check": "node --check lib/index.js",
    "test": "node scripts/check.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": ">=0.2.1-rc.2 <0.3.0 || >=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.2 <0.3.0 || >=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.2 <0.3.0 || >=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-subagent": ">=0.2.1-rc.2 <0.3.0 || >=0.2.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.3.0 || >=0.2.2-rc.1 <0.3.0"
  },
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/",
    "locale/",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs/",
    "scripts/check.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
